{
  "name": "japanese-dict",
  "version": "1.0.0",
  "type": "module",
  "description": "Multilingual Japanese dictionary API",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "test:watch": "bun test --watch",
    "prepare:jmdict": "bun run scripts/pipeline/prepare-jmdict.ts",
    "prepare:kanjidic2": "bun run scripts/pipeline/prepare-kanjidic2.ts",
    "release:build:canonical": "bun run scripts/pipeline/build-canonical-release.ts",
    "import:jmdict:canonical": "bun run scripts/pipeline/import-jmdict-canonical.ts",
    "import:kanjidic2:canonical": "bun run scripts/pipeline/import-kanjidic2-canonical.ts",
    "import:tatoeba:canonical": "bun run scripts/pipeline/import-tatoeba-canonical.ts",
    "import:wiktionary:canonical": "bun run scripts/pipeline/import-wiktionary-canonical.ts",
    "apply:canonical-overlays": "bun run scripts/pipeline/apply-canonical-overlays.ts",
    "preview:canonical-release": "bun run scripts/pipeline/preview-canonical-release.ts",
    "rebuild:canonical": "bun run scripts/pipeline/rebuild-canonical.ts",
    "validate:snapshot": "bun run scripts/pipeline/validate-snapshot.ts",
    "quality:canonical": "bun run scripts/pipeline/report-canonical-quality.ts",
    "docker:build": "docker build -t yori-dict .",
    "docker:run": "docker run -p 3000:3000 -e PORT=3000 -e CANONICAL_RELEASE_DB_PATH=/app/data/releases/canonical/yori-dict.sqlite -v \"$(pwd)/data/releases/canonical:/app/data/releases/canonical:ro\" yori-dict",
    "sdk:generate": "openapi-ts"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.9.44",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.92.4",
    "@types/bun": "latest"
  },
  "license": "CC-BY-SA-4.0"
}
