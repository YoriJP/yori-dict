{
  "name": "japanese-dict",
  "version": "1.0.0",
  "type": "module",
  "description": "Multilingual Japanese dictionary API",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "data:pull": "bun run scripts/pull-data.ts",
    "build:db": "bun run scripts/build-db.ts",
    "release:build": "bun run scripts/release/build.ts",
    "release:activate": "bun run scripts/release/activate.ts",
    "release:promote": "bun run scripts/release/promote.ts",
    "release:cleanup": "bun run scripts/release/cleanup.ts",
    "import:jmdict": "bun run scripts/import/jmdict.ts",
    "import:jmdict-examples": "bun run scripts/import/jmdict-examples.ts",
    "import:jitendex": "bun run scripts/import/jitendex.ts",
    "import:kaikki": "bun run scripts/import/kaikki.ts",
    "import:kowiktionary-ko": "bun run scripts/import/kowiktionary-ko.ts",
    "import:krdict": "bun run scripts/import/krdict.ts",
    "import:jlpt": "bun run scripts/import/jlpt.ts",
    "import:cedict": "bun run scripts/import/cedict.ts",
    "import:frequency": "bun run scripts/import/frequency.ts",
    "import:tatoeba": "bun run scripts/import/tatoeba.ts",
    "import:wadoku": "bun run scripts/import/wadoku.ts",
    "import:wiktionary": "bun run scripts/import/wiktionary.ts",
    "import:gemini": "bun run scripts/import/gemini.ts",
    "update:ai": "bun run scripts/import/gemini.ts --output-mode updates-db",
    "update:source": "bun run scripts/update/source.ts",
    "verify:updates": "bun run scripts/verify-updates.ts",
    "import:zhja": "bun run scripts/import/zhja.ts",
    "import:base": "mkdir -p data/lang && bun run import:jmdict --lang en,de --mode replace && bun run import:kaikki --mode replace && bun run import:krdict --mode replace",
    "import:enrichment": "bun run import:jlpt && bun run import:tatoeba && bun run import:wadoku && bun run import:wiktionary && bun run import:jmdict-examples && bun run import:jitendex && bun run import:kowiktionary-ko && bun run import:cedict && bun run import:frequency && bun run import:zhja",
    "rebuild:all": "bun run import:base && bun run import:enrichment && bun run release:build",
    "sync:zh-cn-from-tw": "bun run scripts/sync-zh-cn-from-tw.ts",
    "audit:kanji-vocab-gaps": "bun run scripts/audit/kanji-vocab-gaps.ts",
    "verify:dict": "bun run scripts/verify-dict.ts",
    "verify:rebuild": "bash scripts/verify-rebuild.sh",
    "cleanup:dict": "bun run scripts/cleanup-dict.ts",
    "add": "bun run scripts/add.ts",
    "docker:build": "docker build -t yori-dict .",
    "docker:run": "docker run -p 3000:3000 -e PORT=3000 yori-dict",
    "sdk:generate": "openapi-ts"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@scalar/hono-api-reference": "^0.9.44",
    "hono": "^4.6.0",
    "jose": "^6.2.3",
    "opencc-js": "^1.0.5",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.92.4",
    "@types/bun": "latest"
  },
  "license": "CC-BY-SA-4.0"
}
