{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yori-dict.local/schemas/snapshot.schema.json",
  "title": "Yori Dict Canonical Snapshot",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "entries", "lookupAliases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "lookupAliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/lookupAlias" }
    },
    "kanjiCharacters": {
      "type": "array",
      "items": { "$ref": "#/$defs/kanjiCharacter" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["kind", "importedAt"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["jmdict", "jmnedict", "kanjidic2", "wiktionary", "tatoeba", "manual", "ai"]
        },
        "sourceId": { "type": "string" },
        "license": { "type": "string" },
        "importedAt": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "promptVersion": { "type": "string" },
        "inputRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reviewStatus": { "enum": ["unreviewed", "approved", "rejected"] }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "form": {
      "type": "object",
      "required": ["id", "text", "normalizedText", "script", "isPrimary", "tags", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ydf_[0-9]{8}$" },
        "text": { "type": "string", "minLength": 1 },
        "normalizedText": { "type": "string", "minLength": 1 },
        "script": { "enum": ["kanji", "kana", "katakana", "mixed"] },
        "isPrimary": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "reading": {
      "type": "object",
      "required": ["id", "text", "normalizedText", "system", "isPrimary", "appliesToFormIds", "tags", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ydr_[0-9]{8}$" },
        "text": { "type": "string", "minLength": 1 },
        "normalizedText": { "type": "string", "minLength": 1 },
        "system": { "const": "kana" },
        "isPrimary": { "type": "boolean" },
        "appliesToFormIds": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "items": { "type": "string", "pattern": "^ydf_[0-9]{8}$" } }
          ]
        },
        "pitchAccent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "sourceRefs"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string" },
              "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
            }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "gloss": {
      "type": "object",
      "required": ["id", "senseId", "lang", "text", "sourceType", "reviewStatus", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ydg_[0-9]{8}$" },
        "senseId": { "type": "string", "pattern": "^yds_[0-9]{8}$" },
        "lang": { "enum": ["en", "de", "ko", "zh-cn", "zh-tw"] },
        "text": { "type": "string", "minLength": 1 },
        "sourceType": { "enum": ["source", "manual", "ai"] },
        "reviewStatus": { "enum": ["unreviewed", "approved", "rejected"] },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "example": {
      "type": "object",
      "required": ["id", "lang", "japanese", "translation", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ydx_[0-9]{8}$" },
        "senseId": { "type": "string", "pattern": "^yds_[0-9]{8}$" },
        "lang": { "enum": ["en", "de", "ko", "zh-cn", "zh-tw"] },
        "japanese": { "type": "string", "minLength": 1 },
        "translation": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "sense": {
      "type": "object",
      "required": ["id", "entryId", "order", "partOfSpeech", "appliesToFormIds", "appliesToReadingIds", "domain", "register", "misc", "glosses", "examples", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^yds_[0-9]{8}$" },
        "entryId": { "type": "string", "pattern": "^yde_[0-9]{8}$" },
        "order": { "type": "integer", "minimum": 1 },
        "partOfSpeech": { "type": "array", "items": { "type": "string" } },
        "appliesToFormIds": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "items": { "type": "string", "pattern": "^ydf_[0-9]{8}$" } }
          ]
        },
        "appliesToReadingIds": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "items": { "type": "string", "pattern": "^ydr_[0-9]{8}$" } }
          ]
        },
        "domain": { "type": "array", "items": { "type": "string" } },
        "register": { "type": "array", "items": { "type": "string" } },
        "misc": { "type": "array", "items": { "type": "string" } },
        "glosses": { "type": "array", "items": { "$ref": "#/$defs/gloss" } },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "language", "entryType", "primaryForm", "primaryReading", "forms", "readings", "senses", "ranking", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^yde_[0-9]{8}$" },
        "language": { "const": "ja" },
        "entryType": { "enum": ["word", "phrase", "proper_noun"] },
        "primaryForm": { "type": "string", "minLength": 1 },
        "primaryReading": { "type": "string", "minLength": 1 },
        "forms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/form" } },
        "readings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reading" } },
        "senses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sense" } },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "common": { "type": "boolean" },
            "frequency": { "type": "integer", "minimum": 1 },
            "jlpt": { "type": "integer", "minimum": 1, "maximum": 5 },
            "priority": { "type": "array", "items": { "type": "string" } }
          }
        },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "lookupAlias": {
      "type": "object",
      "required": ["id", "surface", "normalizedSurface", "entryId", "aliasType", "score"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^yda_[0-9]{8}$" },
        "surface": { "type": "string", "minLength": 1 },
        "normalizedSurface": { "type": "string", "minLength": 1 },
        "reading": { "type": "string" },
        "normalizedReading": { "type": "string" },
        "entryId": { "type": "string", "pattern": "^yde_[0-9]{8}$" },
        "formId": { "type": "string", "pattern": "^ydf_[0-9]{8}$" },
        "readingId": { "type": "string", "pattern": "^ydr_[0-9]{8}$" },
        "aliasType": { "enum": ["dictionary", "variant", "kana", "reading", "normalized"] },
        "score": { "type": "number" }
      }
    },
    "kanjiStats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grade": { "type": "integer", "minimum": 1 },
        "strokeCount": { "type": "integer", "minimum": 1 },
        "frequency": { "type": "integer", "minimum": 1 },
        "jlpt": { "type": "integer", "minimum": 1 }
      }
    },
    "kanjiMeaning": {
      "type": "object",
      "required": ["lang", "text", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "lang": { "enum": ["en", "de", "ko", "zh-cn", "zh-tw"] },
        "text": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "kanjiReading": {
      "type": "object",
      "required": ["type", "text", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["onyomi", "kunyomi", "nanori"] },
        "text": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "kanjiCharacter": {
      "type": "object",
      "required": ["id", "literal", "meanings", "readings", "stats", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ydk_[0-9]{8}$" },
        "literal": { "type": "string", "pattern": "^[\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uF900-\\uFAFF]$" },
        "meanings": { "type": "array", "items": { "$ref": "#/$defs/kanjiMeaning" } },
        "readings": { "type": "array", "items": { "$ref": "#/$defs/kanjiReading" } },
        "stats": { "$ref": "#/$defs/kanjiStats" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    }
  }
}
